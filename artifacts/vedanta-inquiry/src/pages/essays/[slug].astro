---
import { render } from 'astro:content';
import ArticleList from '../../components/ArticleList.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getPublishedArticles, getRelatedArticles, slugifyTaxonomy } from '../../lib/articles';
import { resolveLearningPaths } from '../../lib/learning-paths';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  const paths = resolveLearningPaths(articles);

  return articles.map((article, index) => ({
    params: { slug: article.data.slug },
    props: {
      article,
      previous: articles[index - 1] ?? null,
      next: articles[index + 1] ?? null,
      related: getRelatedArticles(article, articles, 3),
      learningPathLinks: paths
        .filter((path) => path.articleSlugs.includes(article.data.slug))
        .map((path) => ({
          slug: path.slug,
          title: path.title,
          step: path.articleSlugs.indexOf(article.data.slug) + 1,
          total: path.articleSlugs.length,
        })),
    },
  }));
}

const { article, previous, next, related, learningPathLinks } = Astro.props;
const { Content, headings } = await render(article);
const tableOfContents =
  article.data.readingTime >= 5
    ? headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3)
    : [];
const base = import.meta.env.BASE_URL;
const date = new Intl.DateTimeFormat('en', { month: 'long', day: 'numeric', year: 'numeric' }).format(article.data.publicationDate);
---
<SiteLayout title={`${article.data.title} — Vedanta Inquiry`} description={article.data.description}>
  <main id="main-content">
    <header class="article-hero">
      <div class="article-wrap">
        <div class="article-kicker">
          <a href={`${base}categories/${slugifyTaxonomy(article.data.category)}/`}>{article.data.category}</a>
          <span aria-hidden="true">·</span>
          <span>{article.data.readingTime} min read</span>
          {article.data.sample && <span class="sample-badge">Sample article</span>}
        </div>
        <h1>{article.data.title}</h1>
        <p class="article-deck">{article.data.description}</p>
        <p class="eyebrow" style="margin-top:24px; letter-spacing:.08em; text-transform:none; font-weight:500">{date}</p>
        {article.data.series && <p class="article-series">
          Part of <a href={`${base}series/${slugifyTaxonomy(article.data.series)}/`}>{article.data.series}</a>
        </p>}
      </div>
    </header>
    <article class="article-wrap article-content">
      {article.data.tags.length > 0 && <ul class="article-tags" aria-label="Article tags">
        {article.data.tags.map((tag) => <li>{tag}</li>)}
      </ul>}
      {tableOfContents.length > 1 && <nav class="table-of-contents" aria-labelledby="toc-heading">
        <h2 id="toc-heading">On this page</h2>
        <ol>
          {tableOfContents.map((heading) => (
            <li class:list={{ 'toc-subheading': heading.depth === 3 }}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </nav>}
      <div class="prose"><Content /></div>
      {article.data.sourceReferences && article.data.sourceReferences.length > 0 && <section class="source-references" aria-labelledby="sources-heading">
        <h2 id="sources-heading">Source references</h2>
        <ul>
          {article.data.sourceReferences.map((source) => (
            <li>
              {source.url
                ? <a href={source.url} rel="noreferrer">{source.label}</a>
                : <span>{source.label}</span>}
              <span>{source.reference}</span>
            </li>
          ))}
        </ul>
      </section>}
      {learningPathLinks.length > 0 && <section class="article-path-links" aria-labelledby="article-paths-heading">
        <h2 id="article-paths-heading">Continue along a learning path</h2>
        <ul>
          {learningPathLinks.map((path) => (
            <li>
              <a href={`${base}learning-paths/${path.slug}/`}>
                <span>Step {path.step} of {path.total}</span>
                <strong>{path.title}</strong>
              </a>
            </li>
          ))}
        </ul>
      </section>}
      {related.length > 0 && <section class="related-articles" aria-labelledby="related-heading">
        <h2 id="related-heading">Related articles</h2>
        <ArticleList articles={related} />
      </section>}
      <a class="article-back" href={`${base}#readings`}><span aria-hidden="true">←</span> Back to the reading room</a>
      <nav class="article-pagination" aria-label="Article navigation">
        {previous
          ? <a href={`${base}essays/${previous.data.slug}/`}><span>Previous article</span><strong>{previous.data.title}</strong></a>
          : <span class="pagination-empty" />}
        {next
          ? <a class="pagination-next" href={`${base}essays/${next.data.slug}/`}><span>Next article</span><strong>{next.data.title}</strong></a>
          : <span class="pagination-empty" />}
      </nav>
    </article>
  </main>
</SiteLayout>
