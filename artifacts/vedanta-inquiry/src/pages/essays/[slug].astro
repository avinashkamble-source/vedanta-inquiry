---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const essays = await getCollection('essays');
  return essays.map((essay) => ({ params: { slug: essay.id }, props: { essay } }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);
const base = import.meta.env.BASE_URL;
const date = new Intl.DateTimeFormat('en', { month: 'long', day: 'numeric', year: 'numeric' }).format(essay.data.date);
---
<SiteLayout title={`${essay.data.title} — Vedanta Inquiry`} description={essay.data.description}>
  <main id="main-content">
    <header class="article-hero">
      <div class="article-wrap">
        <span class="eyebrow">{essay.data.topic} &nbsp;·&nbsp; {essay.data.readTime}</span>
        <h1>{essay.data.title}</h1>
        <p class="article-deck">{essay.data.description}</p>
        <p class="eyebrow" style="margin-top:24px; letter-spacing:.08em; text-transform:none; font-weight:500">{date}</p>
      </div>
    </header>
    <article class="article-wrap article-content">
      <div class="prose"><Content /></div>
      <a class="article-back" href={`${base}#readings`}><span aria-hidden="true">←</span> Back to the reading room</a>
    </article>
  </main>
</SiteLayout>
